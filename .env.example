# LLM（必填）
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=Pro/zai-org/GLM-5.1
LLM_BASE_URL=https://api.siliconflow.cn/v1

# MySQL 容器初始化
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_APP_USER=insight_app
MYSQL_APP_PASSWORD=change_me_app
MYSQL_READONLY_USER=insight_readonly
MYSQL_READONLY_PASSWORD=change_me_readonly

# 本地运行时连接地址；使用 Docker Compose 时会由 compose 覆盖
META_DB_HOST=localhost
META_DB_PORT=3306
META_DB_USER=insight_app
META_DB_PASSWORD=change_me_app
META_DB_NAME=meta
DW_DB_HOST=localhost
DW_DB_PORT=3306
DW_DB_USER=insight_readonly
DW_DB_PASSWORD=change_me_readonly
DW_DB_NAME=dw

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_EMBEDDING_SIZE=1024
EMBEDDING_HOST=localhost
EMBEDDING_PORT=8081
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=data_agent

# SQL 安全策略
SQL_MAX_LENGTH=20000
SQL_MAX_RESULT_ROWS=1000
SQL_MAX_CORRECTION_ATTEMPTS=2
SQL_MAX_EXECUTION_TIME_MS=15000

# Docker 端口与本地模型路径
MYSQL_PORT=3306
ELASTICSEARCH_PORT_EXPOSED=9200
KIBANA_PORT=5601
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
EMBEDDING_PORT_EXPOSED=8081
BACKEND_PORT=8000
FRONTEND_PORT=3000
EMBEDDING_MODEL_PATH=./embedding/bge-large-zh-v1.5
